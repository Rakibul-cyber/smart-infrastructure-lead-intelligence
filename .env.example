# HTTP request settings
REQUEST_TIMEOUT=20
REQUEST_DELAY_SECONDS=1
MAX_PAGES_PER_SITE=5
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=1
USER_AGENT=SmartInfrastructureLeadIntelligence/0.1

# Scraping strategy
# static keeps Requests + Beautiful Soup only.
# dynamic uses Chromium rendering.
# auto tries static first, then uses Chromium for insufficient static HTML.
SCRAPE_MODE=static

# Crawler link prioritisation
BUSINESS_LINK_PRIORITY_ENABLED=true
GENERAL_LINKS_ENABLED=true

# Browser-rendering fallback settings
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SECONDS=30
BROWSER_WAIT_AFTER_LOAD_SECONDS=0
BROWSER_WAIT_FOR_SELECTOR=
BROWSER_ACCEPT_COOKIES=false

# Dashboard and export defaults
TOP_LEADS_LIMIT=5
OUTPUT_DIRECTORY=data/output

# Logging
LOG_LEVEL=INFO
LOG_FILE=
